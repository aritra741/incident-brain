GEMINI_API_KEY=your_gemini_api_key_here
# Optional Lobster Trap (https://github.com/veeainc/lobstertrap): Gemini OpenAI path through the proxy
# LOBSTER_TRAP_BASE_URL=http://127.0.0.1:8080/v1beta/openai
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_INCIDENT_CHANNEL=incidents
SCREEN_CAPTURE_ENABLED=false
SCREEN_CAPTURE_INTERVAL=30
WARNING_SIMILARITY_THRESHOLD=0.85
# JSON array when the UI is on another origin (e.g. Vercel). Example:
# CORS_ORIGINS=["https://incident-brain.vercel.app"]
